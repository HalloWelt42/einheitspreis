{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.1.0",
  "description": "__MSG_appDescription__",
  "default_locale": "de",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.de/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*",
        "https://www.amazon.nl/*",
        "https://www.amazon.com.be/*",
        "https://www.amazon.pl/*",
        "https://www.amazon.se/*"
      ],
      "js": [
        "core/quantity.js",
        "core/money.js",
        "core/unit-price.js",
        "core/ranking.js",
        "vendor/icons.js",
        "content/runtime.js",
        "content/settings.js",
        "content/labels.js",
        "content/amazon-dom.js",
        "content/badge.js",
        "content/panel.js",
        "content/main.js"
      ],
      "css": ["content/page.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/panel.css", "vendor/fonts/*.woff2"],
      "matches": [
        "https://www.amazon.de/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*",
        "https://www.amazon.nl/*",
        "https://www.amazon.com.be/*",
        "https://www.amazon.pl/*",
        "https://www.amazon.se/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
